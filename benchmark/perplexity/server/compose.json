{
  "services": {
    "pplx-decider-27b": {
      "command": [
        "env",
        "AUTOJEV_CHECKPOINT=/models/hf/hub/models--perplexity-ai--pplx-decider-v1.1-27b/snapshots/6195aa55a72ae21e503c8a60198f7b390d42adb5",
        "PYTHONPATH=/models/hf/hub/models--perplexity-ai--pplx-decider-v1.1-27b/snapshots/6195aa55a72ae21e503c8a60198f7b390d42adb5/source/src",
        "python",
        "/opt/pplx/run_pplx.py"
      ],
      "container_name": "dm-pplx-decider-27b",
      "devices": [
        {
          "source": "/dev/kfd",
          "target": "/dev/kfd",
          "permissions": "rwm"
        },
        {
          "source": "/dev/dri",
          "target": "/dev/dri",
          "permissions": "rwm"
        }
      ],
      "entrypoint": null,
      "environment": {
        "HF_HOME": "/models/hf",
        "HF_HUB_OFFLINE": "1",
        "HSA_OVERRIDE_GFX_VERSION": "11.5.1",
        "PYTORCH_ROCM_ARCH": "gfx1151"
      },
      "group_add": [
        "485",
        "488"
      ],
      "image": "decision-models-pplx:local",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-file": "3",
          "max-size": "10m"
        }
      },
      "mem_limit": "25769803776",
      "memswap_limit": "25769803776",
      "networks": {
        "default": null
      },
      "ports": [
        {
          "mode": "ingress",
          "host_ip": "192.168.0.90",
          "target": 8000,
          "published": "11449",
          "protocol": "tcp"
        }
      ],
      "restart": "no",
      "security_opt": [
        "label:disable"
      ],
      "volumes": [
        {
          "type": "volume",
          "source": "decision_models_pplx",
          "target": "/models",
          "read_only": true,
          "volume": {}
        }
      ]
    }
  },
  "volumes": {
    "decision_models_pplx": {
      "name": "decision_models_pplx",
      "external": true
    }
  }
}
